<?xml version="1.0" encoding="utf-8"?>
<!--
  Repo-scoped: this solution only ever restores from nuget.org (verified - none of the
  project.assets.json files under Backends/Gateway/Shared/Frontends/Testing resolve anything
  from the machine-wide private Azure feeds in %APPDATA%\NuGet\NuGet.Config). Restricting to a
  single source here silences NU1507 (central package management asking for source mapping)
  without touching that global config, which other repos on this machine still rely on.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
