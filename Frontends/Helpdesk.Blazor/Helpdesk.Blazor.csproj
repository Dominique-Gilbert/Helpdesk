<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Helpdesk.Blazor</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The DTO project and nothing else. If a Grpc.* package or a .proto ever appears in
         this file, the tier separation has been broken. -->
    <ProjectReference Include="..\..\Gateway\Helpdesk.Gateway.DTO\Helpdesk.Gateway.DTO.csproj" />
    <ProjectReference Include="..\..\Shared\TenantTheming\TenantTheming.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" />
    <PackageReference Include="MudBlazor" />
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

  <!-- Brand images (logo, etc.) live in Images/ - not wwwroot - so the source-of-truth asset
       isn't mixed in with generated/served web content. Every build copies them into
       wwwroot/images, which is what App.razor and the components actually reference. -->
  <Target Name="CopyBrandImages" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <BrandImages Include="Images\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(BrandImages)" DestinationFolder="wwwroot\images\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
