@page "/clients"
@using Helpdesk.Blazor.Components.Subcomponents
@inject ClientRepo ClientsRepo

<BaseRoleOnly>
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <div>
            <MudText Typo="Typo.h4" GutterBottom="true">Clients</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">Company/customer directory - visible only to BaseRole.</MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreateDrawer">
            New client
        </MudButton>
    </MudStack>

    @if (page is null)
    {
        <MudText Color="Color.Secondary">Loading&hellip;</MudText>
    }
    else
    {
        <ClientsDataGrid Items="page.items" OnEdit="OpenEditDrawer" />
    }

    <ClientEditDrawer Client="editingClient" @bind-Open="drawerOpen" OnSaved="ReloadAsync" />
</BaseRoleOnly>

@code {
    private DtoClientPage? page;
    private DtoClient? editingClient;
    private bool drawerOpen;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync() => page = await ClientsRepo.ListAsync();

    private void OpenCreateDrawer()
    {
        editingClient = null;
        drawerOpen = true;
    }

    private void OpenEditDrawer(DtoClient client)
    {
        editingClient = client;
        drawerOpen = true;
    }
}
