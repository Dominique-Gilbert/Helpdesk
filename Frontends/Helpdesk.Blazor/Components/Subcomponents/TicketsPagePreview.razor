@* A purely presentational mockup of the Tickets page (app bar + nav drawer + grid), fed straight
   from AppTheme.razor's own in-memory (not-yet-saved) form fields - it updates the instant you
   type/pick a color, before Save even runs. Deliberately plain inline styles/scoped CSS, not a
   second MudThemeProvider: MudBlazor's theming works by writing CSS custom properties (e.g.
   --mud-palette-primary) globally, so a second provider scoped to just this preview would fight
   the real app-wide one for the same variables instead of staying isolated. Sample rows and nav
   items are fabricated - this never touches TicketRepo, real ticket data, or real routes; the
   nav "links" below are plain non-interactive markup on purpose (see TicketsPagePreview.razor.css)
   so clicking around a preview can never actually navigate anywhere. *@
<div style="border:1px solid #e0e0e0; border-radius:8px; overflow:hidden; background:#fff; --preview-primary:@EffectiveColor;">
    <div style="display:flex;">
        @if (navOpen)
        {
            <div style="width:150px; background:#000; flex-shrink:0;">
                <div style="padding:12px; display:flex; align-items:center; gap:8px; border-bottom:1px solid rgba(255,255,255,.1);">
                    <img src="@(string.IsNullOrWhiteSpace(LogoUrl) ? "images/logo.png" : LogoUrl)"
                         style="width:22px; height:22px; border-radius:50%; object-fit:cover;" />
                    <span style="color:#fff; font-weight:600; font-size:0.72rem;">@(DisplayName ?? "IT Helpdesk & Assets")</span>
                </div>
                @foreach (var item in NavItems)
                {
                    <div class="preview-nav-item" style="color:#fff; padding:8px 12px; font-size:0.78rem;">@item</div>
                }
            </div>
        }

        <div style="flex:1; min-width:0;">
            <div style="background:#000; padding:10px 16px; display:flex; align-items:center; gap:10px;">
                @* Mirrors the real MainLayout's menu icon exactly - clicking it here only
                   toggles this mockup's own local nav, never a real drawer. *@
                <span class="preview-nav-item" style="color:#fff; font-size:1.1rem; line-height:1; padding:2px 6px; border-radius:4px;" @onclick="() => navOpen = !navOpen">&#9776;</span>
                @if (!navOpen)
                {
                    <img src="@(string.IsNullOrWhiteSpace(LogoUrl) ? "images/logo.png" : LogoUrl)"
                         style="width:28px; height:28px; border-radius:50%; object-fit:cover;" />
                    <span style="color:#fff; font-weight:600; font-size:0.95rem;">@(DisplayName ?? "IT Helpdesk & Assets")</span>
                }
            </div>

            <div style="padding:20px;">
                <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:16px; gap:12px;">
                    <div>
                        <div style="font-size:1.4rem; color:#333;">Tickets</div>
                        <div style="color:#757575; font-size:0.8rem;">Create a ticket, then select it to watch two services react to the same event.</div>
                    </div>
                    <button style="@ButtonStyle" disabled>New ticket</button>
                </div>

                <div style="border-radius:10px; overflow:hidden; box-shadow:0 0 15px rgba(0,0,0,.09);">
                    <div style="@BannerStyle">Most Recent Tickets</div>
                    <table style="width:100%; border-collapse:collapse; font-size:0.8rem;">
                        <thead>
                            <tr style="background:#f5f5f5; text-align:left;">
                                <th style="padding:8px 12px; color:#333;">Reference</th>
                                <th style="padding:8px 12px; color:#333;">Title</th>
                                <th style="padding:8px 12px; color:#333;">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="preview-row" style="border-top:1px solid #eee;">
                                <td style="padding:8px 12px;"><code>TCK-20260919-A1B2C3</code></td>
                                <td style="padding:8px 12px; color:#333;">Laptop won't boot</td>
                                <td style="padding:8px 12px;"><span style="@ChipStyle">New</span></td>
                            </tr>
                            <tr class="preview-row" style="border-top:1px solid #eee;">
                                <td style="padding:8px 12px;"><code>TCK-20260918-D4E5F6</code></td>
                                <td style="padding:8px 12px; color:#333;">VPN access request</td>
                                <td style="padding:8px 12px;"><span style="@ChipStyle">In Progress</span></td>
                            </tr>
                            <tr class="preview-row" style="border-top:1px solid #eee;">
                                <td style="padding:8px 12px;"><code>TCK-20260917-7788AA</code></td>
                                <td style="padding:8px 12px; color:#333;">Printer offline</td>
                                @* Closed/Completed stay neutral in the real grid too (TicketsDataGrid.StatusColor) - Primary is only for the active statuses above. *@
                                <td style="padding:8px 12px;"><span style="background:#e0e0e0; color:#424242; border-radius:16px; padding:2px 10px; font-size:0.72rem;">Closed</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string? PrimaryColor { get; set; }

    [Parameter]
    public string? LogoUrl { get; set; }

    [Parameter]
    public string? DisplayName { get; set; }

    // Purely local UI state for this mockup's own open/close toggle - unrelated to
    // MainLayout's real drawer state.
    private bool navOpen;

    private static readonly string[] NavItems =
        ["Overview", "Tickets", "Assets", "Management", "SLA board", "Users"];

    private string EffectiveColor => string.IsNullOrWhiteSpace(PrimaryColor) ? "#CC0000" : PrimaryColor;

    private string ButtonStyle =>
        $"background:{EffectiveColor}; color:#fff; border:none; border-radius:4px; padding:6px 18px; font-weight:500; font-size:0.8rem;";

    private string BannerStyle =>
        $"background:{EffectiveColor}; color:#fff; padding:10px 16px; font-weight:600; font-size:0.85rem;";

    private string ChipStyle =>
        $"background:{EffectiveColor}; color:#fff; border-radius:16px; padding:2px 10px; font-size:0.72rem;";
}
