<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Helpdesk.Tickets.Api</RootNamespace>
    <AssemblyName>Ticket.API</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AutoMapper" />
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ticket.Infrastructure\Ticket.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Shared\Helpdesk.Mapping\Helpdesk.Mapping.csproj" />
    <ProjectReference Include="..\..\Shared\Helpdesk.Messaging\Helpdesk.Messaging.csproj" />
    <ProjectReference Include="..\..\Shared\Helpdesk.Persistence\Helpdesk.Persistence.csproj" />
    <ProjectReference Include="..\..\Shared\Helpdesk.ServiceDefaults\Helpdesk.ServiceDefaults.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- This domain owns ticket.proto, so it generates the server stubs. -->
    <Protobuf Include="Protos\ticket.proto" GrpcServices="Server" />
  </ItemGroup>
</Project>
